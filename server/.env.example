# --- HTTP / WS server ---
PORT=4000
# Origin allowed by CORS (the Vite dev server)
WEB_ORIGIN=http://localhost:5173

# --- Binance endpoints (override if geo-blocked in your region) ---
# Public data mirror that avoids most geo-blocks: https://data-api.binance.vision
BINANCE_REST=https://api.binance.com
BINANCE_WS=wss://stream.binance.com:9443

# --- Análise de IA (OPCIONAL) ---
# Chave da Anthropic usada por POST /api/analyze. Vazia = rota responde 503.
# Em produção (Vercel) defina a mesma variável nas Environment Variables do projeto.
ANTHROPIC_API_KEY=

# --- PostgreSQL (OPTIONAL) ---
# If unreachable or DB_ENABLED=false, the server runs in proxy mode (no persistence).
DATABASE_URL=postgres://tradeview:tradeview@localhost:5432/tradeview
DB_ENABLED=true
