# Data source: 'backend' (default, uses the Node server) or 'binance' (direct).
VITE_DATA_SOURCE=backend

# Backend mode (VITE_DATA_SOURCE=backend):
VITE_API_BASE=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# Direct mode (VITE_DATA_SOURCE=binance) — override only if geo-blocked:
# VITE_BINANCE_REST=https://api.binance.com
# VITE_BINANCE_WS=wss://stream.binance.com:9443
